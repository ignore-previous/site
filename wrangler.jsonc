// Cloudflare Workers config for ignoreprevious.dev: a Worker that serves static assets only (no script).
// Docs: https://developers.cloudflare.com/workers/static-assets/ and https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "name": "ignoreprevious-site",
  "compatibility_date": "2026-10-24",
  "assets": {
    // build.mjs writes the site here.
    "directory": "./dist",
    // A missing page gets dist/404.html with a 404 status, not an empty response.
    "not_found_handling": "404-page"
  },
  // No *.workers.dev address and no preview URLs: the site is only on its own domain.
  // There is no "routes" key on purpose: the custom domain is managed in the Cloudflare dashboard.
  "workers_dev": false,
  "preview_urls": false
}
